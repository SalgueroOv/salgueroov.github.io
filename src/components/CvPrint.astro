---
import { cv } from '../data/cv';
import { cvPrint } from '../data/cv-print';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = cv[lang];
const print = cvPrint[lang];

const t =
  lang === 'es'
    ? {
        contact: 'Contacto',
        stack: 'Tecnologías',
        languages: 'Idiomas',
        interests: 'Intereses',
        profile: 'Perfil',
        experience: 'Experiencia',
        education: 'Formación'
      }
    : {
        contact: 'Contact',
        stack: 'Technologies',
        languages: 'Languages',
        interests: 'Interests',
        profile: 'Profile',
        experience: 'Experience',
        education: 'Education'
      };

const shortUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
---

<div class="page">
  <aside class="sidebar">
    <img src="/salguero_oviedo-cv.jpg" alt={print.name} class="photo" />
    <h1 class="name">{print.name}</h1>
    <p class="role">{print.role}</p>
    <p class="role-sub">{print.roleSub}</p>

    <h2 class="side-heading">
      <svg viewBox="0 0 24 24" class="side-icon"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.4 0-8 2.2-8 5v2h16v-2c0-2.8-3.6-5-8-5Z"/></svg>
      {t.contact}
    </h2>
    <ul class="contact-list">
      <li>
        <svg viewBox="0 0 24 24" class="row-icon"><path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
        <span>{data.contact.location}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" class="row-icon"><path d="M2 5h20v14H2V5Zm2 2v.4l8 5.6 8-5.6V7l-8 5.6L4 7Z"/></svg>
        <span>{data.contact.email}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" class="row-icon"><path d="M4.98 3.5C4.98 4.9 3.9 6 2.5 6S0 4.9 0 3.5 1.1 1 2.5 1s2.48 1.1 2.48 2.5ZM.2 8h4.6v15H.2V8Zm7.6 0h4.4v2.1h.1c.6-1.2 2.1-2.4 4.4-2.4 4.7 0 5.5 3.1 5.5 7.1V23h-4.6v-7.4c0-1.8 0-4-2.4-4s-2.8 1.9-2.8 3.9V23H7.8V8Z"/></svg>
        <span>{shortUrl(data.contact.linkedin)}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" class="row-icon"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"/></svg>
        <span>{shortUrl(data.contact.github)}</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" class="row-icon"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-3a15.5 15.5 0 0 0-1.4-4.4A8 8 0 0 1 18.9 8ZM12 4.1c.7 1 1.5 2.5 1.9 3.9h-3.8c.4-1.4 1.2-2.9 1.9-3.9ZM4.3 14a8.2 8.2 0 0 1 0-4h3.4a17 17 0 0 0 0 4H4.3Zm.8 2h3a15.5 15.5 0 0 0 1.4 4.4A8 8 0 0 1 5.1 16Zm3-10h-3a8 8 0 0 1 4.4-4.4A15.5 15.5 0 0 0 8.1 6ZM12 19.9c-.7-1-1.5-2.5-1.9-3.9h3.8c-.4 1.4-1.2 2.9-1.9 3.9ZM10.1 14a15 15 0 0 1 0-4h3.8a15 15 0 0 1 0 4h-3.8Zm4.5 6.4a15.5 15.5 0 0 0 1.4-4.4h3a8 8 0 0 1-4.4 4.4ZM16.3 14a17 17 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4Z"/></svg>
        <span>{shortUrl(data.contact.website)}</span>
      </li>
    </ul>

    <h2 class="side-heading">
      <svg viewBox="0 0 24 24" class="side-icon"><path d="M9.4 16.6 4.8 12l4.6-4.6L8 6l-6 6 6 6ZM14.6 16.6 19.2 12l-4.6-4.6L16 6l6 6-6 6Z"/></svg>
      {t.stack}
    </h2>
    <ul class="pill-list">
      {data.stack.map((item) => <li class="pill">{item}</li>)}
    </ul>

    <h2 class="side-heading">
      <svg viewBox="0 0 24 24" class="side-icon"><path d="M12.9 3.1 8.4 21.5l-1.9-.4L11 2.7l1.9.4ZM3.7 12l4-4-1.4-1.4L1 12l5.3 5.3L7.7 16l-4-4Zm16.6 0-4-4 1.4-1.4L23 12l-5.3 5.3-1.4-1.4 4-4Z"/></svg>
      {t.languages}
    </h2>
    <ul class="lang-list">
      {print.languages.map((l) => (
        <li>
          <span class="lang-name">{l.name}</span>
          <span class="lang-level">{l.level}</span>
        </li>
      ))}
    </ul>

    <h2 class="side-heading">
      <svg viewBox="0 0 24 24" class="side-icon"><path d="m12 21-1.4-1.3C5.4 15.4 2 12.3 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.8-3.4 6.9-8.6 11.2L12 21Z"/></svg>
      {t.interests}
    </h2>
    <p class="interests">{print.interests.join(' · ')}</p>
  </aside>

  <main class="main">
    <section>
      <h2 class="main-heading">{t.profile}</h2>
      <p class="summary">{print.summary}</p>
    </section>

    <section>
      <h2 class="main-heading">{t.experience}</h2>
      {print.experience.map((item) => (
        <div class="exp-item">
          <p class="exp-role">{item.role} <span class="exp-company">— {item.company}</span></p>
          <p class="exp-period">{item.period}</p>
          <ul class="exp-bullets">
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <section>
      <h2 class="main-heading">{t.education}</h2>
      {data.education.map((item) => (
        <div class="edu-item">
          <p class="edu-title">{item.title}</p>
          <p class="edu-meta">{item.institution}, {item.period}</p>
        </div>
      ))}
    </section>
  </main>
</div>

<style>
  * {
    box-sizing: border-box;
  }

  .page {
    display: flex;
    width: 210mm;
    height: 297mm;
    padding: 16mm 14mm;
    gap: 10mm;
    background: #ffffff;
    font-family: 'Inter', sans-serif;
    color: #334155;
  }

  /* --- Sidebar --- */
  .sidebar {
    flex: 0 0 60mm;
    display: flex;
    flex-direction: column;
    padding: 6mm 5mm;
    border-radius: 3mm;
    background-color: #f8fafc;
    background-image: radial-gradient(circle, #cbd5e1 0.5px, transparent 0.5px);
    background-size: 8px 8px;
  }

  .photo {
    width: 28mm;
    height: 28mm;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 5mm;
    border: 0.5mm solid #ffffff;
    box-shadow: 0 0 0 0.3mm #cbd5e1;
  }

  .name {
    font-family: 'Baloo 2', sans-serif;
    font-size: 20pt;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.15;
    margin: 0;
  }

  .role {
    margin: 3mm 0 0;
    font-size: 10pt;
    font-weight: 600;
    color: #1e293b;
  }

  .role-sub {
    margin: 1.5mm 0 0;
    font-size: 8.5pt;
    color: #64748b;
    line-height: 1.4;
  }

  .side-heading {
    display: flex;
    align-items: center;
    gap: 2mm;
    margin: 6mm 0 3mm;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #1e3a8a;
  }

  .side-icon {
    width: 3.2mm;
    height: 3.2mm;
    fill: #1e3a8a;
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.2mm;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 2.2mm;
    font-size: 8pt;
    line-height: 1.3;
    word-break: break-word;
  }

  .row-icon {
    width: 3mm;
    height: 3mm;
    margin-top: 0.3mm;
    flex-shrink: 0;
    fill: #475569;
  }

  .pill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5mm;
  }

  .pill {
    font-size: 7pt;
    padding: 1mm 2.5mm;
    border-radius: 5mm;
    border: 0.3mm solid #cbd5e1;
    color: #1e3a8a;
    white-space: nowrap;
  }

  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2mm;
  }

  .lang-name {
    display: block;
    font-size: 8.5pt;
    font-weight: 600;
    color: #1e293b;
  }

  .lang-level {
    display: block;
    font-size: 7.5pt;
    color: #64748b;
  }

  .interests {
    margin: 0;
    font-size: 8pt;
    line-height: 1.5;
  }

  /* --- Main column --- */
  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14mm;
  }

  .main-heading {
    display: flex;
    align-items: center;
    gap: 3mm;
    margin: 0 0 3mm;
    font-size: 11pt;
    font-weight: 700;
    color: #0f172a;
  }

  .main-heading::after {
    content: '';
    flex: 1;
    height: 0.3mm;
    background: #e2e8f0;
  }

  .summary {
    margin: 0;
    font-size: 8.5pt;
    line-height: 1.55;
    color: #334155;
  }

  .exp-item + .exp-item {
    margin-top: 4mm;
  }

  .exp-role {
    margin: 0;
    font-size: 9pt;
    font-weight: 700;
    color: #0f172a;
  }

  .exp-company {
    font-weight: 400;
    color: #334155;
  }

  .exp-period {
    margin: 0.5mm 0 0;
    font-size: 7.5pt;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
  }

  .exp-bullets {
    margin: 2mm 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.3mm;
  }

  .exp-bullets li {
    position: relative;
    padding-left: 3.5mm;
    font-size: 8pt;
    line-height: 1.45;
    color: #475569;
  }

  .exp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.8mm;
    width: 1.2mm;
    height: 1.2mm;
    border-radius: 50%;
    background: #1e3a8a;
  }

  .edu-item + .edu-item {
    margin-top: 3mm;
  }

  .edu-title {
    margin: 0;
    font-size: 8.5pt;
    font-weight: 700;
    color: #0f172a;
  }

  .edu-meta {
    margin: 0.5mm 0 0;
    font-size: 7.8pt;
    color: #64748b;
  }

  .references {
    margin: 5mm 0 0;
    font-size: 7.5pt;
    font-style: italic;
    color: #94a3b8;
  }

  @media print {
    @page {
      size: A4;
      margin: 0;
    }

    html,
    body {
      margin: 0;
      padding: 0;
    }

    .page {
      box-shadow: none;
    }
  }

  @media screen {
    :global(body) {
      display: flex;
      justify-content: center;
      padding: 10mm 0;
      background: #52525b;
    }

    .page {
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
    }
  }
</style>
