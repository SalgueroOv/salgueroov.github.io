---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'es' ? '' : '/en';
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <nav class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href={base || '/'} class="font-semibold">Alejandro Salguero</a>
    <ul class="flex flex-wrap gap-6 text-sm">
      <li><a href={`${base}/#about`}>{t('nav.about')}</a></li>
      <li><a href={`${base}/#experience`}>{t('nav.experience')}</a></li>
      <li><a href={`${base}/#projects`}>{t('nav.projects')}</a></li>
      <li><a href={`${base}/#skills`}>{t('nav.skills')}</a></li>
      <li><a href={`${base}/#contact`}>{t('nav.contact')}</a></li>
    </ul>
    <LanguageSwitcher lang={lang} />
  </nav>
</header>
