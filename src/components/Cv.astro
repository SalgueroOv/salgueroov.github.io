---
import { cv } from '../data/cv';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = cv[lang];
---

<section id="about" class="scroll-mt-16">
  <p class="text-base leading-relaxed text-slate-300">{data.summary}</p>

  <h3 class="mt-10 text-xs font-semibold tracking-widest text-slate-200">{t('section.aptitudes').toUpperCase()}</h3>
  <ul class="mt-4 grid gap-x-8 gap-y-5 sm:grid-cols-2">
    {
      data.aptitudes.map((item) => (
        <li>
          <p class="text-sm font-semibold text-slate-200">{item.title}</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-400">{item.description}</p>
        </li>
      ))
    }
  </ul>

  <h3 class="mt-10 text-xs font-semibold tracking-widest text-slate-200">{t('section.stack').toUpperCase()}</h3>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      data.stack.map((item) => (
        <li class="rounded-full border border-slate-800 bg-slate-900/50 px-3 py-1 font-mono text-xs text-emerald-300">
          {item}
        </li>
      ))
    }
  </ul>

  <div class="mt-10 grid gap-8 sm:grid-cols-2">
    <div>
      <h3 class="text-xs font-semibold tracking-widest text-slate-200">{t('section.languages').toUpperCase()}</h3>
      <ul class="mt-4 space-y-2">
        {
          data.languages.map((item) => (
            <li class="text-sm text-slate-400">
              <span class="font-medium text-slate-200">{item.name}</span> — {item.level}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="text-xs font-semibold tracking-widest text-slate-200">{t('section.interests').toUpperCase()}</h3>
      <ul class="mt-4 space-y-2">
        {data.interests.map((item) => <li class="text-sm text-slate-400">{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<section id="experience" class="mt-24 scroll-mt-16">
  <h2 class="flex items-center gap-4 text-sm font-bold tracking-widest text-slate-100">
    {t('nav.experience').toUpperCase()}
    <span class="h-px flex-1 bg-slate-800" />
  </h2>
  <ul class="mt-8 space-y-10">
    {
      data.experience.map((item) => (
        <li class="group -mx-4 rounded-md p-4 transition-colors hover:bg-slate-900/40 sm:grid sm:grid-cols-[7rem_1fr] sm:gap-6">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500 sm:pt-1">{item.period}</p>
          <div>
            <p class="font-semibold text-slate-100">
              {item.role} <span class="font-normal text-slate-400">· {item.company}</span>
            </p>
            <ul class="mt-3 space-y-2">
              {item.bullets.map((bullet) => (
                <li class="flex gap-2 text-sm leading-relaxed text-slate-400">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-400" />
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section id="education" class="mt-24 scroll-mt-16">
  <h2 class="flex items-center gap-4 text-sm font-bold tracking-widest text-slate-100">
    {t('nav.education').toUpperCase()}
    <span class="h-px flex-1 bg-slate-800" />
  </h2>
  <ul class="mt-8 space-y-6">
    {
      data.education.map((item) => (
        <li class="sm:grid sm:grid-cols-[7rem_1fr] sm:gap-6">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500 sm:pt-1">{item.period.split(' · ')[0]}</p>
          <div>
            <p class="font-semibold text-slate-100">{item.title}</p>
            <p class="mt-1 text-sm text-slate-400">{item.institution}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section id="projects" class="mt-24 scroll-mt-16">
  <h2 class="flex items-center gap-4 text-sm font-bold tracking-widest text-slate-100">
    {t('nav.projects').toUpperCase()}
    <span class="h-px flex-1 bg-slate-800" />
  </h2>
  <ul class="mt-8 space-y-6">
    {
      data.projects.map((project) => (
        <li class="rounded-lg border border-slate-800 p-6 transition-colors hover:border-emerald-400/40 hover:bg-slate-900/40">
          <p class="font-semibold text-slate-100">{project.name}</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{project.description}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <li class="rounded-full border border-slate-800 px-3 py-1 font-mono text-xs text-emerald-300">{tech}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>

<section id="contact" class="mt-24 scroll-mt-16">
  <h2 class="flex items-center gap-4 text-sm font-bold tracking-widest text-slate-100">
    {t('nav.contact').toUpperCase()}
    <span class="h-px flex-1 bg-slate-800" />
  </h2>
  <p class="mt-6 max-w-md text-sm leading-relaxed text-slate-400">{data.contact.phone} · {data.contact.location}</p>
  <a
    href={`mailto:${data.contact.email}`}
    class="mt-6 inline-block rounded-md border border-emerald-400/40 px-6 py-3 font-mono text-sm text-emerald-300 transition-colors hover:bg-emerald-400/10"
  >
    {t('contact.cta')}
  </a>
  <p class="mt-8 text-xs text-slate-600">{t('misc.references')}</p>
</section>
