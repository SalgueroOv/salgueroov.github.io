---
interface Props {
  alt: string;
  class?: string;
}

const { alt, class: className } = Astro.props;
---

<div class:list={['group relative aspect-square shrink-0', className]}>
  <div
    class="absolute -bottom-4 -right-4 h-full w-full rounded-lg border-2 border-amber-400 transition-transform duration-300 ease-out group-hover:-bottom-5 group-hover:-right-5"
  >
  </div>
  <div class="relative isolate h-full w-full overflow-hidden rounded-lg border border-neutral-800 shadow-lg shadow-black/40">
    <img
      src="/salguero_oviedo.png"
      alt={alt}
      width="2289"
      height="1898"
      class="h-full w-full object-cover grayscale transition duration-300 group-hover:grayscale-0"
    />
    {/* Duotone: foto en gris + overlay ámbar en mix-blend-multiply; ambos se desvanecen al hover para revelar la foto a color. */}
    <div class="absolute inset-0 bg-amber-400 mix-blend-multiply transition-opacity duration-300 group-hover:opacity-0"></div>
  </div>
</div>
