---

<div
  id="loading-screen"
  class="fixed inset-0 z-100 flex items-center justify-center bg-neutral-950 transition-opacity duration-700"
  aria-hidden="true"
>
  <svg id="loading-mark" viewBox="0 0 260 90" class="w-56 sm:w-72" aria-hidden="true">
    <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" class="aso-letters">ASO</text>
  </svg>
</div>

<style>
  .aso-letters {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 3.25rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    fill: transparent;
    stroke: #fbbf24;
    stroke-width: 1.5;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
  }

  .aso-letters.draw {
    animation: aso-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  .aso-letters.fill {
    animation: aso-fill 0.6s ease forwards;
  }

  @keyframes aso-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes aso-fill {
    to {
      fill: #fbbf24;
    }
  }
</style>

<script>
  const screenEl = document.getElementById('loading-screen');
  const letters = document.querySelector<SVGTextElement>('.aso-letters');

  if (screenEl && letters) {
    document.documentElement.classList.add('overflow-hidden');

    requestAnimationFrame(() => {
      letters.classList.add('draw');
    });

    window.setTimeout(() => {
      letters.classList.add('fill');
    }, 1000);

    window.setTimeout(() => {
      screenEl.classList.add('opacity-0', 'pointer-events-none');
      document.documentElement.classList.remove('overflow-hidden');
      window.setTimeout(() => screenEl.remove(), 700);
    }, 1900);
  }
</script>
